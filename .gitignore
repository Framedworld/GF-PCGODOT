.vscode

# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
demo/addons/flow_nodes_editor/native/src/*.obj
demo/addons/flow_nodes_editor/native/src/*.os
demo/addons/editor_icon_previewer

*.DS_Store

# Claude Code agent worktree checkouts (transient; never part of the repo)
.claude/worktrees/

# Local editor/tooling state
.sconsign.dblite
demo/addons/flow_nodes_editor/bin/~*.TMP
demo/editor_screenshot.png
demo/editor_screenshot.png.import
demo/orchestrator_preview/
demo/scenes/mcp_test_scene*.tscn
demo/scratch/

# Local assistant/editor integrations; not part of the distributable addon.
demo/addons/godot_ai/
demo/addons/godot_mcp/
demo/addons/orchestrator/

# The dungeon demo ships the referenced subset (~6 MB) of the CC0 KayKit
# Dungeon Remastered pack so the flagship demo works out of the box.
# Source: https://github.com/KayKit-Game-Assets/KayKit-Dungeon-Remastered-1.0
demo/addons/kaykit_dungeon_remastered/**
!demo/addons/kaykit_dungeon_remastered/
!demo/addons/kaykit_dungeon_remastered/Assets/
!demo/addons/kaykit_dungeon_remastered/Assets/LICENSE.txt
!demo/addons/kaykit_dungeon_remastered/Assets/gltf/
!demo/addons/kaykit_dungeon_remastered/Assets/gltf/*.glb
!demo/addons/kaykit_dungeon_remastered/Assets/gltf/*.glb.import
!demo/addons/kaykit_dungeon_remastered/Assets/gltf/*.png
!demo/addons/kaykit_dungeon_remastered/Assets/gltf/*.png.import

# Godot may generate transient imports for documentation screenshots while editing.
demo/addons/flow_nodes_editor/doc/*.png.import
demo/addons/flow_nodes_editor/bin/~*.dll

# GdUnit4 test reports (generated on every run)
demo/reports/
reports/

# Native build intermediates (link-time artifacts — only the .dll is loaded at runtime)
demo/addons/flow_nodes_editor/native/src/*.o
demo/addons/flow_nodes_editor/bin/liblibflow.*.a
demo/addons/flow_nodes_editor/bin/*.exp
demo/addons/flow_nodes_editor/bin/*.lib
# Same artefacts anywhere in the tree (Windows temp copies of a loaded DLL, MSVC
# import libraries/exports), e.g. when the addon is copied over a running editor.
~*.TMP
~*.tmp
*.exp
*.lib

# CI builds the Linux GDExtension fresh (only Windows/macOS binaries are shipped);
# never commit the locally/CI-built Linux library or the godot-cpp build outputs.
demo/addons/flow_nodes_editor/bin/libflow.linux.*.so
godot-cpp/bin/
godot-cpp/gen/
